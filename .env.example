# Any OpenAI-compatible endpoint. Groq for the hosted demo, Ollama for fully local.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
# Copy a current model ID from your provider's model list (Groq console > Models).
LLM_MODEL=llama-3.3-70b-versatile

# Local Ollama instead (no key needed):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b

SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
PORT=3000
